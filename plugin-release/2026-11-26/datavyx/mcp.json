{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "datavyx": {
      "type": "streamable-http",
      "url": "https://kb.datavyx.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "7CoGooGTzCivdedhDG2P2sjhGbcQJZo1"
            },
            "baseScopes": ["knowledge:read"],
            "defaultScopes": [
              "knowledge:read", "knowledge:record", "knowledge:update",
              "knowledge:delete", "knowledge:restore", "knowledge:history", "knowledge:bulk"
            ],
            "oidcEnabled": true,
            "oidcScopesSupported": ["openid", "profile", "email", "offline_access"]
          }
        }
      }
    }
  }
}
