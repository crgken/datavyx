# Protected server configuration; never put real secrets in this example.
MCP_MODE=test
MCP_HOST=127.0.0.1
MCP_PORT=8098
MCP_NEO4J_URI=bolt://127.0.0.1:17694
MCP_NEO4J_DATABASE=neo4j
MCP_NEO4J_USER=neo4j
MCP_NEO4J_PASSWORD=replace-with-test-db-password
MCP_AUTH_ISSUER=https://replace-with-existing-auth0-tenant/
MCP_AUTH_AUDIENCE=https://kb.datavyx.com/mcp-candidate
MCP_AUTH_CLIENT_IDS=replace-with-dedicated-chatgpt-oauth-client-id
MCP_RESOURCE_URL=https://kb.datavyx.com/mcp-candidate
MCP_CURSOR_SECRET=replace-with-at-least-32-random-characters
MCP_MAX_RECORDS=10000
