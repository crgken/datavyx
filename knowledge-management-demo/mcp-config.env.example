# Load through the service manager or your process environment; never commit the real values.
MCP_MODE=production
MCP_HOST=127.0.0.1
MCP_PORT=8098
MCP_NEO4J_URI=bolt://127.0.0.1:17693
MCP_NEO4J_DATABASE=neo4j
MCP_NEO4J_USER=neo4j
MCP_NEO4J_PASSWORD=
MCP_AUTH_ISSUER=https://your-tenant.example/
MCP_AUTH_AUDIENCE=https://kb.example/mcp
# allowlist (default): only explicit client IDs. authenticated: accept any OAuth
# client with a valid user-delegated token for this issuer/API and required scopes.
# Configure Auth0 DCR, connections and third-party API grants separately.
MCP_AUTH_CLIENT_POLICY=allowlist
# May be empty only in authenticated mode. '*' is never a valid client ID.
MCP_AUTH_CLIENT_IDS=
MCP_RESOURCE_URL=https://kb.example/mcp
MCP_CURSOR_SECRET=
MCP_MAX_RECORDS=10000
MCP_RECORDING_ENABLED=0
# Optional restricted validation actors before reopening production recording:
MCP_RECORDING_ACTORS=
# Persistent directory OUTSIDE releases and database volumes; owner-only service account.
# Candidate: /var/lib/atlasai-mcp/candidate-purge-ledger
MCP_PURGE_LEDGER_DIR=/var/lib/atlasai-mcp/purge-ledger
# Dedicated stable >=32-character signing key; back it up securely, never rotate with cursors.
MCP_PURGE_LEDGER_SECRET=
