# This database is dedicated to this Demo. Do not point it at a business database.
KD_NEO4J_URI=bolt://127.0.0.1:17693
KD_NEO4J_USER=neo4j
KD_NEO4J_PASSWORD=atlas-demo-local
KD_NEO4J_DATABASE=neo4j
# Separate Neo4j instance/volume; group_id alone is not isolation in Graphiti 0.30.1.
KD_PENDING_NEO4J_URI=bolt://127.0.0.1:17695
KD_DATASET=default
KD_HOST=127.0.0.1
KD_PORT=8096

# OpenAI-compatible Chat Completions endpoint. Real keys stay in .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
SEMAPHORE_LIMIT=3
GRAPHITI_TELEMETRY_ENABLED=false

# Optional mobile access. Empty means explicitly disabled; desktop still works.
# Public Native application values; no Auth0 client secret is needed.
KD_AUTH0_DOMAIN=
KD_AUTH0_AUDIENCE=
KD_AUTH0_CLIENT_IDS=
# Comma-separated, exact HTTPS origins; loopback HTTP is allowed for local Web development.
KD_WEB_ALLOWED_ORIGINS=
KD_AUTH0_ORGANIZATION_ID=
# Legacy workspace ID used only when binding the existing dataset during migration.
KD_MOBILE_TENANT_ID=
# Name assigned to the existing personal workspace during that migration.
KD_MOBILE_WORKSPACE_NAME=个人空间
# Azure Speech single-service Free F0. Key stays on the backend only.
KD_SPEECH_PROVIDER=azure
KD_AZURE_SPEECH_REGION=eastus
KD_AZURE_SPEECH_KEY=
